# =============================================================================
# AI Auto Training Platform — backend environment TEMPLATE
#
# ⚠ DO NOT put real passwords or tokens in this file.
#   This file is committed to git. Real secrets go in backend/.env, which
#   is .gitignore'd. Workflow:
#       cp .env.example .env
#       # then edit backend/.env with real values
# =============================================================================

# --- App ---
APP_ENV=dev                 # dev | prod
LOG_LEVEL=INFO

# Internal bearer token used by THIS app's API (not Supabase).
# Every request must send: Authorization: Bearer <API_TOKEN>
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
API_TOKEN=aGS0ORDof_JD5WETRN4y52Mc2vxgwm6Jzg-3qZO958YNnZCE8oAp7SJnQISOtUgL

# --- Supabase Postgres ---
# Project ref: hmnvmctmsipybpuxzpde
# Use the asyncpg driver scheme: postgresql+asyncpg://...
#
# IMPORTANT — two endpoints, two USERNAME formats, two purposes:
#
#   DIRECT  host: db.<ref>.supabase.co        port: 5432   user: postgres
#   POOLER  host: aws-0-<region>.pooler....   port: 6543   user: postgres.<ref>
#
# Always use the DIRECT connection for alembic migrations. The pooler runs
# in transaction mode and breaks DDL/prepared statements — that causes
# "Tenant or user not found" if the username is wrong, or weirder errors
# mid-migration if it's right.
#
# The pooler is fine for runtime app traffic later. For v1 (single user,
# local) the direct connection works for everything.
#
# (a) DIRECT connection — required for migrations, fine for runtime in v1:
# DATABASE_URL=postgresql+asyncpg://postgres:YOUR-DB-PASSWORD@db.hmnvmctmsipybpuxzpde.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres.koyfvullbfiayoyxznfg:gUj1OK9B699o5JoP@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres
#
# (b) POOLER connection — only for production runtime, NOT for migrations.
#     Note the username MUST be "postgres.<project-ref>", not "postgres".
# DATABASE_URL=postgresql+asyncpg://postgres.hmnvmctmsipybpuxzpde:YOUR-DB-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# --- Supabase REST keys (NOT used by the backend in v1) ---
# These are kept here for reference / future use (e.g. server-side calls to
# Supabase Auth or Storage). They are NOT used to connect to Postgres.
# SUPABASE_URL=https://hmnvmctmsipybpuxzpde.supabase.co
# SUPABASE_ANON_KEY=sb_publishable_...
# SUPABASE_SERVICE_ROLE_KEY=sb_service_...

# --- Storage ---
STORAGE_BACKEND=local       # local | minio | s3   (only 'local' wired in v1)
STORAGE_ROOT=./data         # used when STORAGE_BACKEND=local

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
